# Copy to .env and fill in the values.
# The setup-vps.sh script generates this automatically.

# Required: shared secret the main server sends as X-Management-Secret header.
# Generate: openssl rand -hex 32
MGMT_API_SECRET=

# Port the management API listens on (default 8443).
PORT=8443

# Optional isolated VLESS+Reality test transport. When enabled, Xray listens
# directly on REALITY_PORT (default 8443); the management API defaults to 8444
# to avoid a host-port collision. Keep these values on the VPS only.
# REALITY_ENABLED=false
# REALITY_PORT=8443
# REALITY_PRIVATE_KEY=
# REALITY_SHORT_ID=
# REALITY_SERVER_NAME=
# REALITY_DEST=example.com:443

# Optional: Telegram bot for node status checks.
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_ADMIN_CHAT_ID=
