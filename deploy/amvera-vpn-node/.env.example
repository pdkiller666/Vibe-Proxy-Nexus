# Copy to .env and fill in the values.
# The setup-vps.sh script generates this automatically.

# Required: shared secret the main server sends as X-Management-Secret header.
# Generate: openssl rand -hex 32
MGMT_API_SECRET=

# Port the management API listens on (default 8443).
PORT=8443

# Optional: Telegram bot for node status checks.
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_ADMIN_CHAT_ID=
