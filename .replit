modules = ["bash", "python-3.12", "web", "nodejs-24", "postgresql-16"]

[deployment]
router = "application"
deploymentTarget = "autoscale"

[deployment.postBuild]
args = ["pnpm", "store", "prune"]
env = { "CI" = "true" }

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "artifacts/api-server: API Server"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "artifacts/vpn-portal: web"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "test-reality-management-tunnel"

[[workflows.workflow]]
name = "seo-smoke"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "pnpm --filter @workspace/vpn-portal run test:seo"

[workflows.workflow.metadata]
isValidation = true

[[workflows.workflow]]
name = "vpn-node"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "pnpm run test:vpn-node"

[workflows.workflow.metadata]
isValidation = true

[[workflows.workflow]]
name = "test-reality-management-tunnel"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "test -n \"$VPS_SSH_USERNAME\" && test -n \"$VPS_SSH_PASSWORD\" || { echo 'Required SSH secrets are unavailable'; exit 1; }; command -v sshpass >/dev/null 2>&1 || { echo 'sshpass is unavailable'; exit 1; }; while :; do SSHPASS=\"$VPS_SSH_PASSWORD\" sshpass -e ssh -N -T -L 127.0.0.1:18444:127.0.0.1:8444 -o StrictHostKeyChecking=yes -o PreferredAuthentications=password -o PubkeyAuthentication=no -o ExitOnForwardFailure=yes -o ServerAliveInterval=30 -o ServerAliveCountMax=3 -o ConnectTimeout=15 \"$VPS_SSH_USERNAME@77.238.246.37\"; status=$?; echo \"SSH management tunnel disconnected (exit $status); retrying in 5s\"; sleep 5; done"

[workflows.workflow.metadata]
outputType = "console"

[agent]
stack = "PNPM_WORKSPACE"
expertMode = true

[postMerge]
path = "scripts/post-merge.sh"
timeoutMs = 20000

[nix]
channel = "stable-25_05"

[userenv]

[userenv.shared]
ADMIN_EMAIL = "tiy247@mail.ru"
NODE_ENV = "development"
VPS_DE_HOST = "91.228.152.241"
VPS_DE_USER = "root"
VPS_NL1_HOST = "87.199.200.19"
VPS_NL1_USER = "root"
BASE_PATH = "/"
AMVERA_PROD_DB_HOST = "vpnexus-db1-pdkiller666.tcp-waw0.amvera.tech"
AMVERA_PROD_DB_PORT = "5432"
AMVERA_PROD_DB_NAME = "Vpnexus-db1"
